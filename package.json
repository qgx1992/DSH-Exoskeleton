{
  "name": "dsh-desktop",
  "version": "0.8.5",
  "description": "DeepSeek Harness 桌面客户端 — 轻量、纯净、功能完整的 DSH 桌面外壳（壳核分离）",
  "main": "out/main/index.js",
  "author": "DSH Exoskeleton",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/run-tests.mjs",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win",
    "release:notes": "node scripts/release-notes.mjs",
    "clean:dist": "node scripts/prune-dist.mjs",
    "gen:icon": "node scripts/build-blackgold.mjs && node scripts/build-whale-component.mjs && electron scripts/render-icons.cjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^34.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "zstddec": "^0.2.0"
  }
}
